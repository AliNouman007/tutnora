{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tutnora-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Blocks outbound fetches to private network addresses (SSRF protection).
  "compatibility_flags": ["global_fetch_strictly_public"],
  "vars": {
    // Hostnames allowed in Host and Origin headers for /mcp. Staging and production add theirs in M6.
    "ALLOWED_HOSTS": "localhost,127.0.0.1",
    // The address apps use to reach Tutnora. Tokens are issued for PUBLIC_URL/mcp only.
    "PUBLIC_URL": "http://localhost:8787",
  },
  "d1_databases": [
    {
      // Local development and tests only. Staging and production databases are added in milestone M6.
      "binding": "DB",
      "database_name": "tutnora",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "kv_namespaces": [
    {
      // OAuth grants and tokens, and short-lived sign-in state (ADR 0005). Local only until milestone M6.
      "binding": "OAUTH_KV",
      "id": "00000000000000000000000000000000",
    },
  ],
}
