{
  "name": "tutnora-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Your Personal AI Learning Companion",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration --passWithNoTests",
    "test:contract": "vitest run test/contract --passWithNoTests",
    "test:security": "vitest run test/security --passWithNoTests",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply tutnora --local"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.6.0",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@vitest/coverage-istanbul": "4.1.12",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12",
    "wrangler": "4.157.0"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  }
}
